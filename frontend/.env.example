VITE_WS_HEARTBEAT_INTERVAL=30000

# 图表配置
VITE_CHART_SAMPLING_KLINE=1000
VITE_CHART_SAMPLING_MINUTE=500

# 刷新配置
VITE_AUTO_REFRESH_INTERVAL=30000
