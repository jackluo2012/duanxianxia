# API服务地址
VITE_API_BASE_URL=http://localhost:8089
VITE_STORAGE_URL=http://localhost:8083
VITE_REALTIME_URL=ws://localhost:8090

# 功能开关
VITE_ENABLE_MOCK=false
VITE_ENABLE_WS=true

# 应用配置
VITE_REQUEST_TIMEOUT=10000
