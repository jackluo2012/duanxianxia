# ClickHouse配置
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=duanxianxia
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duanxianxia

# 服务配置
HOST=127.0.0.1
PORT=8086

# 日志配置
RUST_LOG=info

# 调度配置
ENABLE_REALTIME_MONITOR=true
ENABLE_AFTER_CLOSE_REVIEW=true
AFTER_CLOSE_RUN_TIME=15:30
